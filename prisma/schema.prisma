generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model AuditJob {
  id              String   @id @default(cuid())
  status          String   @default("pending")
  businessName    String
  websiteUrl      String
  phoneNumber     String?
  industry        String
  city            String
  state           String
  email           String
  stripeSessionId String?  @unique
  paid            Boolean  @default(false)
  results         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
