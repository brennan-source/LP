generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model Assessment {
  id              String   @id @default(cuid())
  status          String   @default("scanning") // scanning | awaiting_quiz | complete | failed
  paid            Boolean  @default(false)
  stripeSessionId String?  @unique

  // Business info
  businessName    String
  websiteUrl      String
  phoneNumber     String?
  industry        String
  city            String
  state           String
  teamSize        String
  revenueRange    String
  email           String

  // Scan results (JSON)
  scanResults     String?

  // Quiz answers (JSON)
  quizAnswers     String?

  // Final report (JSON)
  report          String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
