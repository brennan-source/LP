generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Contact {
  id               String    @id @default(cuid())
  firstName        String?
  lastName         String?
  email            String    @unique
  phone            String?
  businessName     String?
  industry         String?
  city             String?
  state            String?
  website          String?
  linkedinUrl      String?
  stage            String    @default("prospect")
  source           String    @default("scraped")
  tags             String?
  hasWebsite       Boolean   @default(true)
  weakWebsite      Boolean   @default(false)
  auditScore       Int?
  previewSlug      String?   @unique
  previewUrl       String?
  postcardSentAt   DateTime?
  previewVisitedAt DateTime?
  notes            Note[]
  activities       Activity[]
  products         ContactProduct[]
  client           Client?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model ContactProduct {
  id         String    @id @default(cuid())
  contactId  String
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  product    String
  status     String    @default("prospect")
  paidAt     DateTime?
  valuecents Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}

model Activity {
  id          String   @id @default(cuid())
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type        String
  description String?
  metadata    String?
  createdAt   DateTime @default(now())
}

model Campaign {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("email")
  subject   String   @default("")
  body      String
  status    String   @default("draft")
  sentCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id          String   @id @default(cuid())
  contactId   String   @unique
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tier        String
  monthlyRate Int
  startDate   DateTime
  framerUrl   String?
  domain      String?
  status      String   @default("active")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
